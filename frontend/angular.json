{
  "$schema":"./node_modules/@angular/cli/lib/config/schema.json",
  "version":1,
  "newProjectRoot":"projects",
  "projects": {
    "jornada-diaconal-web": {
      "projectType":"application",
      "schematics":{},
      "root":"",
      "sourceRoot":"src",
      "prefix":"app",
      "architect": {
        "build": {
          "builder":"@angular/build:application",
          "options": {
            "outputPath":"dist/jornada-diaconal-web",
            "index":"src/index.html",
            "browser":"src/main.ts",
            "polyfills":["zone.js"],
            "tsConfig":"tsconfig.app.json",
            "assets":[{"glob":"**/*","input":"public"}],
            "styles":["src/styles.css"]
          },
          "configurations": {
            "production":{"budgets":[{"type":"initial","maximumWarning":"1mb","maximumError":"2mb"}],"outputHashing":"all"},
            "development":{"optimization":false,"sourceMap":true}
          },
          "defaultConfiguration":"production"
        },
        "serve": {
          "builder":"@angular/build:dev-server",
          "configurations":{"production":{"buildTarget":"jornada-diaconal-web:build:production"},"development":{"buildTarget":"jornada-diaconal-web:build:development"}},
          "defaultConfiguration":"development"
        }
      }
    }
  },
  "cli":{"analytics":false}
}